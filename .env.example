# AEGIS Temporal Worker — Environment Variables
# Copy this file to .env and fill in your values.

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-agents

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://temporal:temporal@localhost:5432/aegis

# ── AEGIS Runtime gRPC ────────────────────────────────────────────────────────
AEGIS_RUNTIME_GRPC_URL=localhost:50051

# ── AEGIS Orchestrator HTTP (for event callbacks) ─────────────────────────────
AEGIS_ORCHESTRATOR_URL=http://localhost:8088

# ── HTTP Server ───────────────────────────────────────────────────────────────
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ── Worker concurrency ────────────────────────────────────────────────────────
MAX_CONCURRENT_ACTIVITY_TASK_EXECUTIONS=100
MAX_CONCURRENT_WORKFLOW_TASK_EXECUTIONS=100

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

# ── Proto ─────────────────────────────────────────────────────────────────────
# Path to aegis_runtime.proto. In Docker this is set via ENV in the Dockerfile.
# For local dev relative to CWD: ./proto/aegis_runtime.proto
PROTO_PATH=./proto/aegis_runtime.proto
